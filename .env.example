# Google OAuth client IDs — Cloud Console › APIs & Services › Credentials.
#
# NOT secrets. EXPO_PUBLIC_* values are inlined into the JS bundle at build time
# and ship inside the APK; they are public by design. The Android OAuth client
# is deliberately absent — Google matches it by package name + SHA-1 at sign-in
# time, so it is never referenced from code.
#
# Copy to .env and fill in.
#
# EAS builds do NOT see this file (.env is gitignored, and EAS uploads via git).
# Register the values there instead:
#   eas env:create --environment production \
#     --name EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID --value <id> --visibility plaintext
#
# After editing .env, restart Metro with `npx expo start --clear` — inlined
# values are cached and a stale one will waste an afternoon.

# "Web application" OAuth client. Required by @react-native-google-signin
# even though Poisha has no server. Leave empty to disable Drive backup:
# the Settings row hides itself rather than the app failing to boot.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# "iOS" OAuth client. Not used until the iOS phase; the config plugin's
# iosUrlScheme in app.json is the reversed form of this id.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
